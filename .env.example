# One provider key is enough. The app needs its own API key: Claude Code and Cursor subscriptions don't provide one.
ANTHROPIC_API_KEY=
# Set this only for the NTP Novi Sad hackathon gateway; leave it out to call Anthropic directly.
# ANTHROPIC_BASE_URL=https://api.app.jigjoy.ai/gateway/anthropic
OPENAI_API_KEY=
GEMINI_API_KEY=
# Keep this line, empty: it keeps Mozaik's cloud telemetry off (it would send full prompts to JigJoy's dashboard).
MOZAIK_API_KEY=
# Optional: where the dataset lives (default data/einstein/data)
# PRENUP_DATA=data/einstein/data
