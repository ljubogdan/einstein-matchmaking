{
  "name": "prenup",
  "version": "0.0.0",
  "private": true,
  "description": "Mozaik agents that pre-negotiate researcher-company collaborations on the EINSTEIN dataset",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo": "tsx src/run.ts",
    "check-key": "tsx src/check-key.ts",
    "find-contested": "tsx eval/find-contested.ts",
    "fixture-latency": "tsx eval/fixture-latency.ts",
    "board": "tsx src/board/server.ts",
    "eval:critic": "tsx eval/critic.ts",
    "eval:arbiter": "tsx eval/arbiter.ts && tsx eval/arbiter.ts --lww",
    "eval:timeline": "tsx eval/timeline.ts",
    "eval": "npm run eval:critic -- --replay && npm run eval:arbiter && npm run eval:timeline"
  },
  "dependencies": {
    "@mozaik-ai/core": "4.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
